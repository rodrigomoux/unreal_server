# Local development only — never commit real secrets
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

MONGODB_URI=mongodb://survival:survival@localhost:27017/survival?authSource=admin
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-change-me-jwt-secret-min-32-chars
